# Example Database Connection Configuration
# Copy this file to db.properties and customize for your environment

db.host=localhost
db.port=3306
db.name=college_event_db
db.user=root
db.password=your_secure_password_here

db.url=jdbc:mysql://localhost:3306/college_event_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
